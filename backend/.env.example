PORT=8080

# Either set DATABASE_URL, or the discrete PG_* vars below
DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_manager

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=event_manager

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
